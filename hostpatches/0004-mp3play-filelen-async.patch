 platforms/atari/audio/dmasnd.h            |   2 +-
 platforms/atari/audio/dmasnd_hdmi.c       | 121 ++++++++++++++++++++--
 platforms/atari/network/atari_natfeat.cpp |   6 +-
 3 files changed, 120 insertions(+), 9 deletions(-)

